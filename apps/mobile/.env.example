# Consumed by ClerkProvider in App.tsx; public, safe to embed in the Android app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Consumed by the account API client. HTTPS API origin; no trailing /api.
# Android emulator local API: http://10.0.2.2:3000 (development builds only).
EXPO_PUBLIC_API_URL=
# Public Web application OAuth client ID, consumed by Clerk's native Google hook
# through app.config.ts extra. Optional for email-code sign-in. No client secret.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
# Optional build-time file path: app.config.ts passes the intended Firebase Android
# client config to Expo for FCM registration. No service is provisioned by the app.
GOOGLE_SERVICES_JSON=
