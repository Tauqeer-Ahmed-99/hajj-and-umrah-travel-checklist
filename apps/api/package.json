{
  "name": "@nmt/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "check:clerk": "node --env-file-if-exists=.env.local --import tsx scripts/check-clerk.ts",
    "check:linked-account": "node --env-file-if-exists=.env.local --import tsx scripts/check-linked-account.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@clerk/backend": "3.28.0",
    "@clerk/shared": "^4.45.0",
    "@nmt/contracts": "*",
    "file-type": "^22.3.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "jose": "^6.1.0",
    "tsx": "^4.20.0"
  }
}
