# Server only: pg connection pool and the migration command.
# For Neon, use its pooled URL with sslmode=require; never embed this in Expo.
DATABASE_URL=
# Server only: Clerk signature verification, active-session and verified-email lookup.
CLERK_SECRET_KEY=
# Used by the API to bind session verification to this Clerk instance's issuer.
CLERK_PUBLISHABLE_KEY=
# Optional, server only: notification-dispatch.ts authenticates Expo Push requests.
# Enable enhanced push security in the intended Expo project before setting this.
EXPO_ACCESS_TOKEN=
# Optional, server only: /api/notifications/dispatch verifies Vercel's cron bearer.
# Daily reconciliation; ordinary application routes and builds require neither.
CRON_SECRET=

# Optional until using file routes. Server-only guide-storage.ts validates these
# lazily after authorization; account/trip/text-guide requests and builds need none.
# Exact R2 S3 endpoint: https://<32-character-account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
